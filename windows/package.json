{
  "name": "toolbox-windows",
  "productName": "Toolbox",
  "version": "3.6.0",
  "description": "Toolbox – everyday tools for Windows",
  "main": "main.js",
  "author": "Noah Hartmann",
  "license": "SEE LICENSE IN ../LICENSE",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "smoke:sync": "node scripts/smoke-sync.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "dist:store": "node scripts/build-store.js"
  },
  "dependencies": {
    "bonjour-service": "1.4.4",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.noahsapps.Toolbox",
    "productName": "Toolbox",
    "copyright": "© 2026 Noah Hartmann",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "NHoart",
        "repo": "Toolbox"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Toolbox-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Toolbox",
      "uninstallDisplayName": "Toolbox"
    },
    "appx": {
      "applicationId": "Toolbox",
      "displayName": "Toolbox for Windows",
      "publisherDisplayName": "NHoartApps",
      "languages": [
        "de-DE",
        "en-US",
        "es-ES",
        "fr-FR"
      ],
      "capabilities": [
        "runFullTrust",
        "privateNetworkClientServer"
      ],
      "backgroundColor": "#080b13",
      "showNameOnTiles": true,
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.22621.0",
      "artifactName": "Toolbox-${version}.${ext}"
    }
  }
}
