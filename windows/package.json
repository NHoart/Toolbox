{
  "name": "toolbox-windows",
  "productName": "Toolbox",
  "version": "3.0.0",
  "description": "Toolbox – Alltagswerkzeuge für Windows",
  "main": "main.js",
  "author": "Noah Hartmann",
  "license": "SEE LICENSE IN ../LICENSE",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "smoke:sync": "node scripts/smoke-sync.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "bonjour-service": "1.4.4"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.noahsapps.Toolbox",
    "productName": "Toolbox",
    "copyright": "© 2026 Noah Hartmann",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Toolbox-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Toolbox",
      "uninstallDisplayName": "Toolbox"
    }
  }
}
