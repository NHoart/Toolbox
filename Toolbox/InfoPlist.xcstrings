    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolbox gleicht deine Daten mit deinem anderen Gerät im selben WLAN ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolbox sincroniza tus datos con tu otro dispositivo en la misma red Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolbox synchronise vos données avec votre autre appareil sur le même réseau Wi-Fi."
          }
        }
      }
    }
  },
