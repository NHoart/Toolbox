    "Sync over Wi-Fi": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync im WLAN"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizar por Wi-Fi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniser en Wi-Fi"
          }
        }
      }
    },
    "Syncs the water tracker and counter directly with your other devices on the same Wi-Fi network – no server. Enter the same name on all devices; only devices with that name sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleicht Wassertracker und Zähler direkt mit deinen anderen Geräten im selben WLAN ab – ohne Server. Trage auf allen Geräten denselben Namen ein; nur Geräte mit diesem Namen gleichen sich ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza el seguimiento de agua y el contador directamente con tus otros dispositivos en la misma red Wi-Fi, sin servidor. Introduce el mismo nombre en todos los dispositivos; solo se sincronizan los dispositivos con ese nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronise le suivi d'eau et le compteur directement avec vos autres appareils sur le même réseau Wi-Fi, sans serveur. Saisissez le même nom sur tous les appareils ; seuls les appareils portant ce nom se synchronisent."
          }
        }
      }
    },
    "Syncs the water tracker and counter directly with your other devices on the same Wi-Fi network – no server. Only devices with the same name sync with each other.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleicht Wassertracker und Zähler direkt mit deinen anderen Geräten im selben WLAN ab – ohne Server. Nur Geräte mit demselben Namen gleichen sich ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza el seguimiento de agua y el contador directamente con tus otros dispositivos en la misma red Wi-Fi, sin servidor. Solo se sincronizan los dispositivos con el mismo nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronise le suivi d'eau et le compteur directement avec vos autres appareils sur le même réseau Wi-Fi, sans serveur. Seuls les appareils portant le même nom se synchronisent."
          }
        }
      }
    },
